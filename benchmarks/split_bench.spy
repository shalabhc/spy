"""
Benchmark: str.split, four implementations across five input shapes.

Implementations:
  - baseline : stdlib str.split() (committed low-level byte loop)
  - spy_find : find()-based split, pure SPy. find() = scalar find_byte() scan to
               the separator's first byte + exact_match() to verify the rest.
  - memchr   : same shape, byte scan is str.find_byte_c (libc memchr, SIMD).
  - memmem   : the whole substring search is one libc memmem() call per field.

Inputs (all ~100 KB):
  - dense_single      : 1-byte sep every ~6 B   (allocation-bound)
  - dense_multi       : 3-byte sep every ~8 B   (allocation-bound)
  - rare_single       : 1-byte sep every ~1 KB  (scan-bound)
  - rare_multi        : 3-byte sep every ~1 KB, first byte unique to the sep
  - rare_multi_decoys : 3-byte sep every ~1 KB, but the sep's first byte occurs
                        every 10 B as a false start

Each row is timed with CPU time (time.cpu_time), best of REPEATS runs of ITERS
splits each (so the reported number is the least-interfered run). Only the
split() call is timed; the checksum is computed after the clock stops.

The @bench decorator wraps each split impl into a self-timing runner: it's a
blue decorator, so the wrapped impl is captured at compile time and called as a
direct call (SPy can't pass functions as runtime values).

Run:
    spy build -x --release benchmarks/split_bench.spy
"""

from time import cpu_time
from _str import StrObject


# scalar single-byte scan (pure SPy)
def find_byte(self: str, ch: u8, start: i32) -> i32:
    ll = StrObject.from_str(self)
    n = ll.length
    i = start
    while i < n and not ll.utf8[i] == ch:
        i = i + 1
    result: i32 = -1
    if i < n:
        result = i
    return result


# true iff `sub` occurs in `self` starting exactly at idx
def exact_match(self: str, idx: i32, sub: str) -> bool:
    ll = StrObject.from_str(self)
    lsub = StrObject.from_str(sub)
    m = lsub.length
    result = True
    if idx + m > ll.length:
        result = False
    else:
        j = 0
        while j < m:
            if not ll.utf8[idx + j] == lsub.utf8[j]:
                result = False
                break
            j = j + 1
    return result


# scan with scalar find_byte, verify with exact_match
def find_spy(self: str, sep: str, start: i32) -> i32:
    n = len(self)
    sep_len = len(sep)
    first: u8 = StrObject.from_str(sep).utf8[0]
    pos = start
    result: i32 = -1
    while pos <= n - sep_len:
        cand = find_byte(self, first, pos)
        if cand == -1 or cand > n - sep_len:
            break
        if sep_len == 1 or exact_match(self, cand, sep):
            result = cand
            break
        pos = cand + 1
    return result


# scan with libc memchr (str.find_byte_c), verify with exact_match
def find_memchr(self: str, sep: str, start: i32) -> i32:
    n = len(self)
    sep_len = len(sep)
    first: u8 = StrObject.from_str(sep).utf8[0]
    pos = start
    result: i32 = -1
    while pos <= n - sep_len:
        cand = self.find_byte_c(first, pos)
        if cand == -1 or cand > n - sep_len:
            break
        if sep_len == 1 or exact_match(self, cand, sep):
            result = cand
            break
        pos = cand + 1
    return result


# combine per-field hashes (content + order): a real correctness check, and still
# forces the split result to be materialized so it can't be optimized away
def checksum(parts: list[str]) -> i32:
    h: i32 = 0
    for p in parts:
        h = h * 31 + hash(p)
    return h


# blue decorator: turn a split impl `fn(s, sep) -> list[str]` into a self-timing
# runner `(label, s, sep, iters, repeats) -> None` that prints best-of-repeats.
@blue
def bench(fn):
    def run(label: str, s: str, sep: str, iters: i32, repeats: i32) -> None:
        best: f64 = 0.0
        res = fn(s, sep)
        rr = 0
        while rr < repeats:
            t0 = cpu_time()
            k = 0
            while k < iters:
                res = fn(s, sep)
                k = k + 1
            dt = cpu_time() - t0
            if rr == 0 or dt < best:
                best = dt
            rr = rr + 1
        print(label, str(best), "s  ck", checksum(res))

    return run


@bench
def split_baseline(s: str, sep: str) -> list[str]:
    return s.split(sep)


@bench
def split_spy_find(s: str, sep: str) -> list[str]:
    sep_len = len(sep)
    n = len(s)
    result = list[str]()
    start: i32 = 0
    idx = find_spy(s, sep, start)
    while idx != -1:
        result.append(s[start:idx])
        start = idx + sep_len
        idx = find_spy(s, sep, start)
    result.append(s[start:n])
    return result


@bench
def split_memchr(s: str, sep: str) -> list[str]:
    sep_len = len(sep)
    n = len(s)
    result = list[str]()
    start: i32 = 0
    idx = find_memchr(s, sep, start)
    while idx != -1:
        result.append(s[start:idx])
        start = idx + sep_len
        idx = find_memchr(s, sep, start)
    result.append(s[start:n])
    return result


@bench
def split_memmem(s: str, sep: str) -> list[str]:
    sep_len = len(sep)
    n = len(s)
    result = list[str]()
    start: i32 = 0
    idx = s.find_sub_c(sep, start)
    while idx != -1:
        result.append(s[start:idx])
        start = idx + sep_len
        idx = s.find_sub_c(sep, start)
    result.append(s[start:n])
    return result


def main() -> None:
    s_dense_single = "hello," * 16667                  # ~100 KB
    s_dense_multi = "hello|||" * 12500                 # ~100 KB
    s_rare_single = ("a" * 1000 + ",") * 100           # ~100 KB
    s_rare_multi = ("a" * 1000 + "qzx") * 100          # ~100 KB, no decoys
    s_rare_decoys = ("qabcdefghi" * 100 + "qzx") * 100  # ~100 KB, 'q' every 10 B
    ITERS = 3000
    REPEATS = 3

    print("split benchmark (CPU time, best of 3)")

    print("")
    split_baseline("dense_single  baseline", s_dense_single, ",", ITERS, REPEATS)
    split_spy_find("dense_single  spy_find", s_dense_single, ",", ITERS, REPEATS)
    split_memchr("dense_single  memchr  ", s_dense_single, ",", ITERS, REPEATS)
    split_memmem("dense_single  memmem  ", s_dense_single, ",", ITERS, REPEATS)

    print("")
    split_baseline("dense_multi   baseline", s_dense_multi, "|||", ITERS, REPEATS)
    split_spy_find("dense_multi   spy_find", s_dense_multi, "|||", ITERS, REPEATS)
    split_memchr("dense_multi   memchr  ", s_dense_multi, "|||", ITERS, REPEATS)
    split_memmem("dense_multi   memmem  ", s_dense_multi, "|||", ITERS, REPEATS)

    print("")
    split_baseline("rare_single   baseline", s_rare_single, ",", ITERS, REPEATS)
    split_spy_find("rare_single   spy_find", s_rare_single, ",", ITERS, REPEATS)
    split_memchr("rare_single   memchr  ", s_rare_single, ",", ITERS, REPEATS)
    split_memmem("rare_single   memmem  ", s_rare_single, ",", ITERS, REPEATS)

    print("")
    split_baseline("rare_multi    baseline", s_rare_multi, "qzx", ITERS, REPEATS)
    split_spy_find("rare_multi    spy_find", s_rare_multi, "qzx", ITERS, REPEATS)
    split_memchr("rare_multi    memchr  ", s_rare_multi, "qzx", ITERS, REPEATS)
    split_memmem("rare_multi    memmem  ", s_rare_multi, "qzx", ITERS, REPEATS)

    print("")
    split_baseline("rare_decoys   baseline", s_rare_decoys, "qzx", ITERS, REPEATS)
    split_spy_find("rare_decoys   spy_find", s_rare_decoys, "qzx", ITERS, REPEATS)
    split_memchr("rare_decoys   memchr  ", s_rare_decoys, "qzx", ITERS, REPEATS)
    split_memmem("rare_decoys   memmem  ", s_rare_decoys, "qzx", ITERS, REPEATS)
